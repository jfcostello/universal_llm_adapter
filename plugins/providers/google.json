{
  "id": "google",
  "compat": "google",
  "endpoint": {
    "urlTemplate": "SDK_BASED_NOT_USED",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "${GEMINI_API_KEY}"
    }
  },
  "realtime": {
    "compat": "gemini",
    "endpoint": {
      "urlTemplate": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService/BidiGenerateContent",
      "headers": {},
      "query": {
        "key": "${GEMINI_API_KEY}"
      }
    }
  },
  "retryWords": [
    "rate limit",
    "quota",
    "resource exhausted",
    "RESOURCE_EXHAUSTED"
  ]
}
