# Public base URL for TwiML + WS Stream URL generation (e.g. https://xxxx.ngrok.app)
PUBLIC_BASE_URL=

# HTTP listen options
HOST=127.0.0.1
PORT=3000

# Twilio bridge WS token secret (used to sign the Stream URL query token)
TWILIO_STREAM_TOKEN_SECRET=change-me

# Realtime session config (provider-agnostic identifiers)
REALTIME_PROVIDER_ID=
REALTIME_MODEL=
REALTIME_SYSTEM_PROMPT=You are a helpful assistant.

# Provider-specific environment variables may also be required depending on your plugins config.
