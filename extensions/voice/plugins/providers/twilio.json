{
  "id": "twilio",
  "kind": "twilio",
  "defaults": {
    "accountSid": "${TWILIO_ACCOUNT_SID?}",
    "authToken": "${TWILIO_AUTH_TOKEN?}",
    "apiBaseUrl": "https://api.twilio.com",
    "outbound": {
      "mode": "twiml",
      "timeoutMs": 15000
    },
    "mediaStreams": {
      "outboundBufferMaxFrames": 15000
    }
  }
}
